# MediaDeck — deployment environment. Copy to `deploy/.env` and fill in.
# deploy/.env is git-ignored — NEVER commit real secrets.
# Anything left blank keeps that adapter in safe MOCK mode; the stack still boots.

# ─────────────────────────── core paths (NAS: TRaSH single /data layout) ──────────────────────────
# On the Synology these live under one shared volume so hardlinks/atomic moves work.
DATA_ROOT=/volume1/data
PUID=1029                      # the dedicated `dockerlimited` user
PGID=100
TZ=Asia/Bangkok

# Media roots INSIDE the containers (keep these; they map to $DATA_ROOT/media/* in compose)
MEDIA_TV_PATH=/data/media/tv
MEDIA_MOVIES_PATH=/data/media/movies
DOWNLOADS_PATH=/data/downloads

# ─────────────────────────────────────── storage ───────────────────────────────────────
# sqlite = local file (default, zero cloud setup). firestore = cloud brain (spec §10).
STORAGE_BACKEND=sqlite
SQLITE_PATH=/data/mediadeck/mediadeck.db
# For firestore, mount the service-account JSON read-only and point here:
# STORAGE_BACKEND=firestore
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# ─────────────────────────────────────── orchestrator ───────────────────────────────────
ORCH_HOST=0.0.0.0
ORCH_PORT=4000
ORCH_PUBLIC_URL=http://orchestrator:4000
POSTER_CACHE_DIR=/data/mediadeck/cache/posters

# ─────────────────────────── adapters: set *_MODE=real + creds to activate ───────────────
SONARR_MODE=mock
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

PROWLARR_MODE=mock
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# TMDB v4 Read Access Token (Authorization: Bearer)
TMDB_MODE=mock
TMDB_READ_TOKEN=

# Synology Download Station (default grabber). Use the shared-folder-relative dest, no leading /.
DOWNLOADSTATION_MODE=mock
DOWNLOADSTATION_URL=http://192.168.0.100:5000
DOWNLOADSTATION_USER=
DOWNLOADSTATION_PASS=

# qBittorrent (fallback client, category tv-sonarr)
QBITTORRENT_MODE=mock
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

# ntfy push
NTFY_MODE=mock
NTFY_URL=http://ntfy:80
NTFY_TOPIC=mediadeck

# ─────────────────────────────────────── Deck AI ───────────────────────────────────────
DECK_MODE=mock
ANTHROPIC_API_KEY=
DECK_MODEL=claude-sonnet-5

# ─────────────────────────────────────── auth (build requirement) ──────────────────────
# Firebase Authentication, Google provider, with an allow-list of permitted emails.
AUTH_MODE=mock
FIREBASE_AUTH_ALLOWLIST=

# ─────────────────────────────────────── scheduling ────────────────────────────────────
SCAN_CRON=0 * * * *
CAPABILITY_CRON=*/30 * * * *
SCHEDULES_ENABLED=true

# ─────────────────────────── dashboard (built into the image) ──────────────────────────
# Same-origin: nginx in the dashboard image proxies /api → orchestrator, so leave blank.
VITE_ORCH_URL=
